# ==============================================================================
# Female Wellness & Lifestyle MCP Server - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your deployment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Anthropic Claude API Configuration
# ------------------------------------------------------------------------------
# API key for Anthropic Claude models.
# Note: Optional if Claude Desktop / MCP client performs reasoning over MCP tools.
# Required if invoking server-side generation tools (e.g., ask_wellness_question).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model identifier for server-side generation
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 2. ChromaDB Vector Store Configuration
# ------------------------------------------------------------------------------
# Local path where ChromaDB persists vector embeddings and metadata
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Name of the collection storing female wellness knowledge embeddings
CHROMA_COLLECTION_NAME=female_wellness_knowledge

# ------------------------------------------------------------------------------
# 3. Sentence Transformers Embedding Configuration
# ------------------------------------------------------------------------------
# Hugging Face model identifier for generating local dense embeddings
# Recommended: BAAI/bge-small-en-v1.5 (384 dimensions, fast on CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# 4. RAG Document Ingestion & Chunking
# ------------------------------------------------------------------------------
# Target maximum character count for each text chunk
CHUNK_SIZE=800

# Overlap character count between consecutive chunks to maintain semantic flow
CHUNK_OVERLAP=150

# ------------------------------------------------------------------------------
# 5. RAG Retrieval Parameters
# ------------------------------------------------------------------------------
# Default maximum number of chunks retrieved per query
TOP_K=5

# Minimum similarity score cutoff (1 - cosine distance) for relevance filtering
# Values range from 0.0 (allow everything) to 1.0 (exact match only)
SIMILARITY_THRESHOLD=0.35

# ------------------------------------------------------------------------------
# 6. Logging & Operational Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Logs are always written strictly to STDERR to protect MCP STDIO stream integrity.
LOG_LEVEL=INFO

